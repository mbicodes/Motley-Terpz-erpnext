 "font_size": 14,
 "html": "{#- ==========================================================================\n    MASTER TOUCH MANUFACTURING - PRODUCTION LOG for one production run\n    DocType : Material Request (a Manufacturing Process run:\n              Fresh Frozen -> Bubble Hash -> Rosin)\n\n    Printed from the Print Log button on the run's card. The data comes from\n    run_production_log() in cannabis_management/api/manufacturing_process.py\n    (a Jinja method, see hooks.py); this template is layout only. It follows\n    the FROZEN BIO TO ROSIN sheet of the Conversion Entry \"Production Log\"\n    format. Blank cells are filled in by hand for the log book (Metrc UIDs,\n    sanitation, QC).\n    ========================================================================== -#}\n\n{%- set LICENSE_NAME = \"MASTER TOUCH MANUFACTURING\" -%}\n{%- set LICENSE_NO   = \"DCC-10004754\" -%}\n{%- set EQUIPMENT    = \"Acsess Rosin Wash Machine/ Blue Apline Freeze Dryers/Low Temp Rosin Press\" -%}\n{%- set log = run_production_log(doc.name) -%}\n\n{%- macro grams(v) -%}{{ \"%.2f\"|format(v or 0) }}{%- endmacro -%}\n{%- macro pct(v) -%}{% if v is not none %}{{ \"%.2f\"|format(v) }}%{% endif %}{%- endmacro -%}\n\n<style>\n  .pl { font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif; color:#000; font-size:8pt; line-height:1.25; }\n  .pl * { box-sizing:border-box; color:#000; }\n\n  table.pl-head { width:100%; border-collapse:collapse; border-bottom:2px solid #000; margin-bottom:6px; }\n  table.pl-head td { padding:0 0 4px; vertical-align:bottom; }\n  .pl-lic { font-size:9pt; letter-spacing:.14em; text-transform:uppercase; }\n  .pl-title { font-size:14pt; font-weight:700; letter-spacing:.04em; margin-top:2px; }\n  .pl-ref { text-align:right; font-size:8pt; line-height:1.5; }\n  .pl-ref b { font-size:10pt; }\n  .pl-warn { border:1.5px solid #000; padding:3px 6px; margin-bottom:6px; font-weight:700; }\n\n  .pl-bar { border-top:1.5px solid #000; border-bottom:1px solid #000;\n            font-size:7.5pt; font-weight:700; letter-spacing:.16em;\n            text-transform:uppercase; padding:2px 2px; margin:7px 0 0; }\n\n  table.pl-t { width:100%; border-collapse:collapse; table-layout:fixed; }\n  table.pl-t th, table.pl-t td { border:1px solid #000; padding:1px 4px; vertical-align:top; word-wrap:break-word; background:#fff !important; }\n  table.pl-t th { font-size:6.5pt; letter-spacing:.06em; text-transform:uppercase; text-align:left; font-weight:700; }\n  table.pl-t tr { page-break-inside:avoid; }\n  /* Frappe's print stylesheet pads every cell 6px !important. */\n  .print-format table.pl-t td, .print-format table.pl-t th { padding:2px 4px !important; }\n  .print-format table.pl-head td { padding:0 0 4px !important; }\n  .pl-lbl { font-size:6.5pt; letter-spacing:.06em; text-transform:uppercase; font-weight:700; }\n  .pl-val { font-size:8.5pt; }\n  .pl-mono { font-family:\"Courier New\", monospace; font-size:8.5pt; }\n  .pl-eq { height:34px; font-size:8.5pt; font-weight:700; }\n  .pl-note { font-size:7pt; font-weight:400; }\n  .pl-fill { height:18px; }\n  .pl-fill-tall { height:26px; }\n  .pl-c { text-align:center; }\n  .pl-r { text-align:right; }\n  .pl-tot { font-weight:700; }\n  .pl-stage { font-weight:700; }\n  .pl-foot { margin-top:8px; border-top:1px solid #000; padding-top:3px; font-size:7pt; }\n</style>\n\n<div class=\"pl\">\n\n  <table class=\"pl-head\">\n    <tr>\n      <td>\n        <div class=\"pl-lic\">{{ LICENSE_NAME }}</div>\n        <div class=\"pl-title\">FROZEN BIO TO ROSIN</div>\n      </td>\n      <td class=\"pl-ref\">\n        <b>{{ log.name }}</b><br>\n        Batch {{ log.batch or \"—\" }}<br>\n        License No. <span class=\"pl-mono\">{{ LICENSE_NO }}</span>\n      </td>\n    </tr>\n  </table>\n\n  {%- if not log.rosin_done %}\n  <div class=\"pl-warn\">Rosin has not been created for this run yet. This log is not complete.</div>\n  {%- endif %}\n\n  <!-- BATCH IDENTIFICATION -->\n  <table class=\"pl-t\">\n    <colgroup><col style=\"width:18%\"><col style=\"width:32%\"><col style=\"width:18%\"><col style=\"width:32%\"></colgroup>\n    <tr>\n      <td class=\"pl-lbl\">Production Date</td>\n      <td class=\"pl-val pl-mono\">{{ log.production_date }}</td>\n      <td class=\"pl-lbl\">Production Time</td>\n      <td class=\"pl-val pl-mono\">{{ log.production_time }}</td>\n    </tr>\n    <tr>\n      <td class=\"pl-lbl\">Batch ID</td>\n      <td class=\"pl-val\">{{ log.batch }}</td>\n      <td class=\"pl-lbl\">Manufactured By</td>\n      <td class=\"pl-val\">{{ log.manufactured_by }}</td>\n    </tr>\n    <tr>\n      <td class=\"pl-lbl\">License Number</td>\n      <td class=\"pl-val pl-mono\">{{ LICENSE_NO }}</td>\n      <td class=\"pl-lbl\">Rosin Completed</td>\n      <td class=\"pl-val pl-mono\">{{ log.completed }}</td>\n    </tr>\n    <tr>\n      <td class=\"pl-lbl\">Routing</td>\n      <td class=\"pl-val\">{{ log.routing }}</td>\n      <td class=\"pl-lbl\">New Metrc UID</td>\n      <td class=\"pl-fill\"></td>\n    </tr>\n  </table>\n\n  <!-- EQUIPMENT -->\n  <div class=\"pl-bar\">Equipment &amp; Sanitation</div>\n  <table class=\"pl-t\">\n    <colgroup><col style=\"width:58%\"><col style=\"width:27%\"><col style=\"width:15%\"></colgroup>\n    <tr><th>Equipment</th><th>Date / Time of Sanitation</th><th class=\"pl-c\">Initial</th></tr>\n    <tr>\n      <td class=\"pl-eq\">\n        {{ EQUIPMENT }}\n        {%- if log.workstations %}\n        <div class=\"pl-note\">Workstations used: {{ log.workstations | join(\", \") }}</div>\n        {%- endif %}\n      </td>\n      <td></td><td></td>\n    </tr>\n    <tr><td class=\"pl-fill\"></td><td></td><td></td></tr>\n  </table>\n\n  <!-- CANNABIS SOURCE -->\n  <div class=\"pl-bar\">Cannabis Source</div>\n  <table class=\"pl-t\">\n    <colgroup><col style=\"width:17%\"><col style=\"width:21%\"><col style=\"width:30%\"><col style=\"width:9%\"><col style=\"width:14%\"><col style=\"width:9%\"></colgroup>\n    <tr>\n      <th>Type</th><th>Metrc UID</th><th>Batch Info</th>\n      <th class=\"pl-r\">LBS</th><th class=\"pl-r\">Grams Used</th><th class=\"pl-c\">Initial</th>\n    </tr>\n    {%- for s in log.source %}\n    <tr>\n      <td>{{ s.item_group }}</td>\n      <td class=\"pl-fill\"></td>\n      <td><span class=\"pl-mono\">{{ s.item_code }}</span> &nbsp; {{ s.item_name }}</td>\n      <td class=\"pl-r pl-mono\">{{ \"%.2f\"|format(s.lbs) }}</td>\n      <td class=\"pl-r pl-mono\">{{ grams(s.grams) }}</td>\n      <td class=\"pl-c\">{{ log.stages[0].initials if log.stages else \"\" }}</td>\n    </tr>\n    {%- endfor %}\n    <tr><td class=\"pl-fill\"></td><td></td><td></td><td></td><td></td><td></td></tr>\n    <tr class=\"pl-tot\">\n      <td colspan=\"3\" class=\"pl-r\">Total Cannabis Input</td>\n      <td class=\"pl-r pl-mono\">{{ \"%.2f\"|format(log.input_lbs) }}</td>\n      <td class=\"pl-r pl-mono\">{{ grams(log.input_grams) }}</td>\n      <td></td>\n    </tr>\n  </table>\n\n  <!-- PROCESS LOG -->\n  <div class=\"pl-bar\">Process Log</div>\n  <table class=\"pl-t\">\n    <colgroup><col style=\"width:17%\"><col style=\"width:10%\"><col style=\"width:18%\"><col style=\"width:12%\"><col style=\"width:12%\"><col style=\"width:10%\"><col style=\"width:21%\"></colgroup>\n    <tr><th>Step</th><th>Employee</th><th>Workstation</th><th>Start</th><th>End</th><th class=\"pl-r\">Time</th><th>Note</th></tr>\n    {%- for st in log.stages %}\n    <tr><td colspan=\"7\" class=\"pl-stage\">{{ st.operation }} &rarr; {{ st.item_name }}</td></tr>\n    {%- for step in st.steps %}\n    <tr>\n      <td>{{ step.name }}</td>\n      <td>{{ step.employees }}</td>\n      <td>{{ step.workstation }}</td>\n      <td>{{ step.start }}</td>\n      <td>{{ step.end }}</td>\n      <td class=\"pl-r\">{{ step.duration }}</td>\n      <td>{{ step.note }}</td>\n    </tr>\n    {%- endfor %}\n    {%- endfor %}\n  </table>\n\n  <!-- FINISHED GOOD -->\n  <div class=\"pl-bar\">Finished Good</div>\n  <table class=\"pl-t\">\n    <colgroup><col style=\"width:13%\"><col style=\"width:19%\"><col style=\"width:34%\"><col style=\"width:10%\"><col style=\"width:15%\"><col style=\"width:9%\"></colgroup>\n    <tr>\n      <th>Type</th><th>New Metrc UID</th><th>Batch Info</th>\n      <th class=\"pl-r\">Grams</th><th>Created On</th><th class=\"pl-c\">Initial</th>\n    </tr>\n    {%- for st in log.stages %}\n    <tr>\n      <td>{{ st.item_group }}</td>\n      <td class=\"pl-fill\"></td>\n      <td><span class=\"pl-mono\">{{ st.item_code }}</span> &nbsp; {{ st.item_name }}\n        {%- if st.microns %}\n        <div class=\"pl-note\">Microns:\n          {%- for m in st.microns %} {{ m.micron_size }} {{ grams(m.grams_collected) }}g{{ \" (\" ~ m.quality_grade ~ \")\" if m.quality_grade }}{{ \" ·\" if not loop.last }}{%- endfor %}\n        </div>\n        {%- endif %}\n      </td>\n      <td class=\"pl-r pl-mono\">{% if st.made %}{{ grams(st.produced) }}{% endif %}</td>\n      <td>{{ st.posted }}</td>\n      <td class=\"pl-c\">{{ st.initials }}</td>\n    </tr>\n    {%- endfor %}\n  </table>\n\n  <!-- YIELD -->\n  <div class=\"pl-bar\">Yield</div>\n  <table class=\"pl-t\">\n    <colgroup><col style=\"width:34%\"><col style=\"width:16%\"><col style=\"width:18%\"><col style=\"width:16%\"><col style=\"width:16%\"></colgroup>\n    <tr><th></th><th class=\"pl-r\">Expected Yield</th><th class=\"pl-r\">Actual Grams</th><th class=\"pl-r\">Actual Yield</th><th class=\"pl-c\">Initial</th></tr>\n    {%- for y in log.yields %}\n    <tr>\n      <td class=\"pl-lbl\">{{ y.label }}</td>\n      <td class=\"pl-r pl-mono\">{{ pct(y.expected) }}</td>\n      <td class=\"pl-r pl-mono\">{% if y.grams is not none %}{{ grams(y.grams) }}{% endif %}</td>\n      <td class=\"pl-r pl-mono\">{{ pct(y.actual) }}</td>\n      <td></td>\n    </tr>\n    {%- endfor %}\n    <tr>\n      <td class=\"pl-lbl\">Deviations / Notes</td>\n      <td colspan=\"4\" class=\"pl-fill-tall\">\n        {%- for n in log.notes %}\n        <div>{{ n.where }}: {{ n.note }}</div>\n        {%- endfor %}\n      </td>\n    </tr>\n  </table>\n\n  <!-- QC -->\n  <div class=\"pl-bar\">QC Check</div>\n  <table class=\"pl-t\">\n    <colgroup><col style=\"width:34%\"><col style=\"width:22%\"><col style=\"width:22%\"><col style=\"width:22%\"></colgroup>\n    <tr><th>Name</th><th>Date</th><th>Time</th><th class=\"pl-c\">Initial</th></tr>\n    <tr><td class=\"pl-fill-tall\"></td><td></td><td></td><td></td></tr>\n  </table>\n\n  <div class=\"pl-foot\">\n    {{ LICENSE_NAME }} &nbsp;&bull;&nbsp; {{ LICENSE_NO }} &nbsp;&bull;&nbsp; {{ log.name }}\n    &nbsp;&bull;&nbsp; Printed {{ frappe.utils.format_datetime(frappe.utils.now_datetime(), \"MM/dd/yyyy hh:mm a\") }}\n  </div>\n\n</div>\n",
 "idx": 0,
