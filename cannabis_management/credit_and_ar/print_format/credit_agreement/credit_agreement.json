 "doctype": "Print Format",
 "font_size": 13,
 "html": "{%- set billing_addresses = frappe.get_all('Address', filters=[['Dynamic Link', 'link_doctype', '=', 'Customer'], ['Dynamic Link', 'link_name', '=', doc.customer]], fields=['address_line1', 'address_line2', 'city', 'state', 'pincode', 'is_primary_address'], order_by='is_primary_address desc', limit=1) if doc.customer else [] -%}\n{%- set billing_address = billing_addresses[0] if billing_addresses else None -%}\n<style>\n.ca-agree * { box-sizing: border-box; }\n.ca-agree { font-family: Helvetica, Arial, sans-serif; color: #1a1a1a; font-size: 12.5px; line-height: 1.5; }\n.ca-agree .ca-companywrap { text-align: center; }\n.ca-agree .ca-companyname { display: inline-block; font-size: 14px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid #999; padding: 4px 18px; margin: 0 auto 14px; }\n.ca-agree h1.ca-title { text-align: center; font-size: 22px; font-weight: 700; margin: 0 0 16px; }\n.ca-agree hr.ca-rule { border: none; border-top: 1px solid #333; margin: 0 0 16px; }\n.ca-agree h2.ca-section { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 20px 0 10px; border-bottom: 1px solid #ccc; padding-bottom: 4px; }\n.ca-agree table.ca-grid { width: 100%; border-collapse: collapse; margin-bottom: 4px; }\n.ca-agree table.ca-grid > tr > td { border: none; padding: 5px 6px 9px 0; vertical-align: top; }\n.ca-agree table.ca-row { width: 100%; border-collapse: collapse; }\n.ca-agree table.ca-row td { border: none; padding: 0; vertical-align: middle; }\n.ca-agree table.ca-row td.ca-label-cell { font-weight: 700; white-space: nowrap; padding-right: 8px; }\n.ca-agree table.ca-row td.ca-field-cell { width: 100%; }\n.ca-agree .ca-field {\n\tdisplay: block;\n\tbackground: #eef2f6;\n\tborder: 1px solid #c7d1db;\n\tborder-radius: 4px;\n\tpadding: 4px 8px;\n\tmin-height: 14px;\n}\n.ca-agree p.ca-body { margin: 0 0 10px; font-size: 12px; }\n.ca-agree table.ca-sign { width: 100%; margin-top: 26px; border-collapse: collapse; }\n.ca-agree table.ca-sign > tr > td { border: none; vertical-align: top; width: 50%; padding: 0 24px 10px 0; }\n</style>\n\n<div class=\"ca-agree\">\n  <div class=\"ca-companywrap\"><span class=\"ca-companyname\">Motley Terpz</span></div>\n  <h1 class=\"ca-title\">Credit Agreement</h1>\n  <hr class=\"ca-rule\">\n\n  <h2 class=\"ca-section\">Account Information</h2>\n  <table class=\"ca-grid\">\n    <tr>\n      <td style=\"width:50%;\"><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Business Name:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.exact_legal_buyer or doc.dba_name or \"\" }}</span></td>\n      </tr></table></td>\n      <td style=\"width:50%;\"><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Date:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ frappe.utils.formatdate(frappe.utils.nowdate(), 'MM-dd-yyyy') }}</span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Contact Name:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.requestor_name or \"\" }}</span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Phone:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.requestor_phone or \"\" }}</span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Email:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.requestor_email or \"\" }}</span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">License #:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.license_number or \"\" }}</span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">AP Contact:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.ap_contact_name or \"\" }}</span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">AP Email:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.ap_contact_email or \"\" }}</span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td colspan=\"2\"><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Business Address:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ (billing_address.address_line1 or \"\") if billing_address else \"\" }}{% if billing_address and billing_address.address_line2 %}, {{ billing_address.address_line2 }}{% endif %}</span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td colspan=\"2\"><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">City:</td>\n        <td class=\"ca-field-cell\" style=\"width:40%;\"><span class=\"ca-field\">{{ (billing_address.city or \"\") if billing_address else \"\" }}</span></td>\n        <td class=\"ca-label-cell\" style=\"padding-left:16px;\">State:</td>\n        <td class=\"ca-field-cell\" style=\"width:20%;\"><span class=\"ca-field\">{{ (billing_address.state or \"\") if billing_address else \"\" }}</span></td>\n        <td class=\"ca-label-cell\" style=\"padding-left:16px;\">ZIP:</td>\n        <td class=\"ca-field-cell\" style=\"width:20%;\"><span class=\"ca-field\">{{ (billing_address.pincode or \"\") if billing_address else \"\" }}</span></td>\n      </tr></table></td>\n    </tr>\n  </table>\n\n  <h2 class=\"ca-section\">Agreed Terms</h2>\n  <table class=\"ca-grid\">\n    <tr>\n      <td style=\"width:50%;\"><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Credit Limit:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.get_formatted(\"approved_limit\") if doc.approved_limit else \"\" }}</span></td>\n      </tr></table></td>\n      <td style=\"width:50%;\"><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Payment Terms:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ doc.approved_terms or \"\" }}</span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Late Fee:</td>\n        <td class=\"ca-field-cell\" style=\"width:35%;\"><span class=\"ca-field\"></span></td>\n        <td class=\"ca-label-cell\" style=\"font-weight:400; padding-left:8px;\">% / month</td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Effective Date:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Sales Rep:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ frappe.db.get_value(\"Sales Person\", doc.sales_person, \"sales_person_name\") if doc.sales_person else \"\" }}</span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Approved By:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ frappe.get_fullname(doc.approved_by) if doc.approved_by else \"\" }}</span></td>\n      </tr></table></td>\n    </tr>\n  </table>\n\n  <h2 class=\"ca-section\">Acknowledgment</h2>\n  <p class=\"ca-body\">By signing below, the client agrees to the credit terms outlined above, including the agreed late fee on past-due balances and responsibility for all collection and legal costs incurred to recover past-due funds.</p>\n\n  <h2 class=\"ca-section\">Reconciliation</h2>\n  <p class=\"ca-body\">Reconciliation clause acknowledged: the Company may request the client's ledger at any time a balance remains open on this account. The client agrees to provide such ledger records within 72 hours of the request. Refusal or failure to provide the requested records within this window will render the full outstanding balance immediately due, and will suspend the credit terms outlined in this Agreement.</p>\n\n  <h2 class=\"ca-section\">Company Discretion</h2>\n  <p class=\"ca-body\">Company reserves the right to reduce, suspend, or revoke credit at any time in its sole discretion. Unless otherwise agreed in writing, all payments received will be applied to the oldest outstanding balance first.</p>\n\n  <table class=\"ca-sign\">\n    <tr>\n      <td><h2 class=\"ca-section\" style=\"margin-top:0;\">Client Signature</h2></td>\n      <td><h2 class=\"ca-section\" style=\"margin-top:0;\">Company Authorization</h2></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Signature:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Signature:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Name:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Name:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\">{{ frappe.get_fullname(doc.approved_by) if doc.approved_by else \"\" }}</span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Title:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Title:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n    </tr>\n    <tr>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Date:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n      <td><table class=\"ca-row\"><tr>\n        <td class=\"ca-label-cell\">Date:</td>\n        <td class=\"ca-field-cell\"><span class=\"ca-field\"></span></td>\n      </tr></table></td>\n    </tr>\n  </table>\n</div>\n",
