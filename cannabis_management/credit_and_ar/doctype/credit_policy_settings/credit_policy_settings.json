   "label": "Finance Charges Enabled"
  },
  {
   "default": "1.5",
   "depends_on": "finance_charge_enabled",
   "description": "Simple, non-compounding, pro-rated by day from the day after the due date.",
   "fieldname": "monthly_rate",
   "fieldtype": "Percent",
   "label": "Monthly Rate"
  },
  {
   "depends_on": "finance_charge_enabled",
   "description": "The lower of this and the monthly rate is charged. Leave blank for no statutory ceiling.",
   "fieldname": "max_lawful_rate",
   "fieldtype": "Percent",
   "label": "Maximum Lawful Monthly Rate"
  },
  {
