 "fields": [
  {
   "fieldname": "sb_policy_dates",
   "fieldtype": "Section Break",
   "label": "Policy Dates"
  },
  {
   "description": "Invoices dated <b>before</b> this date belong to the Legacy Recovery Register: collected on their original terms, never charged finance charges, and excluded from the new-book AR cap, DSO and CEI. <b>Every scheduled Credit &amp; AR job stays inert until this date is set.</b>",
   "fieldname": "policy_effective_date",
   "fieldtype": "Date",
   "label": "Policy Effective Date"
  },
  {
   "fieldname": "cb_policy_dates",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "policy_dates_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted small\">Set this once, at go-live. Changing it later re-classifies historical invoices between the Legacy and New Book ledgers.</p>"
  },
  {
   "fieldname": "sb_exposure",
   "fieldtype": "Section Break",
   "label": "Exposure Measurement"
  },
  {
   "fieldname": "ar_source",
   "fieldtype": "Select",
   "label": "AR Source for Credit Checks",
   "options": "General Ledger\nSales Invoice Outstanding",
   "default": "General Ledger",
   "description": "Where the receivable half of a customer's exposure is read from. <b>General Ledger</b> is the net party balance on Receivable accounts, so payments and journal credits posted against the customer count even when nobody allocated them to an invoice. <b>Sales Invoice Outstanding</b> sums unpaid invoices only, and therefore ignores unapplied payments."
  },
  {
   "fieldname": "customer_ar_cap",
   "fieldtype": "Currency",
   "label": "Per-Customer AR Cap (hard block)",
   "default": "400000",
   "description": "A customer whose AR would pass this figure cannot have any Terms Sales Order or Sales Invoice submitted — no deposit, approval or policy exemption gets through it. Set to 0 to switch the cap off. This is per customer; the company-wide cap under Thresholds is a separate, warning-only check."
  },
  {
   "fieldname": "sb_thresholds",
   "fieldtype": "Section Break",
   "label": "Company-Wide Thresholds"
  },
  {
   "default": "400000",
   "description": "New-book AR only. Legacy balances are reported separately and do not trigger the freeze.",
   "fieldname": "total_ar_cap",
   "fieldtype": "Currency",
   "label": "Total AR Cap"
  },
  {
   "default": "14",
   "fieldname": "dso_target_days",
   "fieldtype": "Int",
   "label": "DSO Target (Days)"
  },
  {
   "default": "30",
   "description": "Freeze when DSO reaches this value.",
   "fieldname": "dso_breach_days",
   "fieldtype": "Int",
   "label": "DSO Breach (Days)"
  },
  {
   "fieldname": "cb_thresholds",
   "fieldtype": "Column Break"
  },
  {
   "default": "100",
   "fieldname": "cei_target",
   "fieldtype": "Percent",
   "label": "CEI Target"
  },
  {
   "default": "85",
   "description": "Freeze when CEI falls below this value.",
   "fieldname": "cei_breach_below",
   "fieldtype": "Percent",
   "label": "CEI Breach Below"
  },
  {
   "fieldname": "thresholds_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted small\">A breach on any one metric freezes all new unsecured exposure &mdash; including good-standing accounts.</p>"
  },
  {
   "fieldname": "sb_stop_work",
   "fieldtype": "Section Break",
   "label": "Stop Work Rule"
  },
  {
   "default": "1",
   "fieldname": "warning_enabled",
   "fieldtype": "Check",
   "label": "Raise Warning on First Day Past Due"
  },
  {
   "default": "5",
   "description": "Hard hold once any invoice is more than this many days past due.",
   "fieldname": "hard_hold_days",
   "fieldtype": "Int",
   "label": "Hard Hold After (Days Past Due)"
  },
  {
   "fieldname": "cb_stop_work",
   "fieldtype": "Column Break"
  },
  {
   "default": "1000",
   "description": "Hard hold once total past-due reaches this amount, regardless of age.",
   "fieldname": "hard_hold_amount",
   "fieldtype": "Currency",
   "label": "Hard Hold At (Past Due Amount)"
  },
  {
   "fieldname": "stop_work_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted small\">Whichever trigger comes first applies. A hard hold blocks Sales Order submit, Delivery Note, Work Order and production Stock Entry. Quotations are always allowed.</p>"
  },
  {
   "fieldname": "sb_limits",
   "fieldtype": "Section Break",
   "label": "Limits &amp; Terms"
  },
  {
   "default": "20000",
   "description": "Recommended limits above this amount require enhanced assessment notes on the Credit Application.",
   "fieldname": "enhanced_review_threshold",
   "fieldtype": "Currency",
   "label": "Enhanced Review Threshold"
  },
  {
   "fieldname": "default_payment_terms_template",
   "fieldtype": "Link",
   "label": "Default Payment Terms Template",
   "options": "Payment Terms Template"
  },
  {
   "default": "30",
   "description": "Hard ceiling. Nothing beyond Net 30, ever.",
   "fieldname": "max_terms_days",
   "fieldtype": "Int",
   "label": "Maximum Terms (Days)"
  },
  {
   "fieldname": "cb_limits",
   "fieldtype": "Column Break"
  },
  {
   "description": "Comma-separated Payment Terms Template names. Approving a Credit Application on any of these requires a written MD exception reason.",
   "fieldname": "terms_requiring_md_exception",
   "fieldtype": "Small Text",
   "label": "Terms Requiring MD Exception"
  },
  {
   "fieldname": "sb_finance_charge",
   "fieldtype": "Section Break",
   "label": "Finance Charge"
  },
  {
   "default": "0",
