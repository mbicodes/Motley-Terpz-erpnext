{
 "name": "Credit Review",
 "doctype": "DocType",
 "module": "Credit Management",
 "autoname": "format:CREV-{YYYY}-{#####}",
 "track_changes": 1,
 "description": "Quarterly review by Finance and MD. Limits move up, down, or to zero on payment history.",
 "field_order": [
  "customer", "review_date", "column_break_1", "quarter", "reviewer",
  "detail_section", "previous_line", "new_line", "column_break_2", "decision", "md_approval", "notes"
 ],
 "fields": [
  {"fieldname": "customer", "fieldtype": "Link", "options": "Customer", "label": "Customer", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "review_date", "fieldtype": "Date", "label": "Review Date", "default": "Today", "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "quarter", "fieldtype": "Data", "label": "Quarter", "in_standard_filter": 1},
  {"fieldname": "reviewer", "fieldtype": "Link", "options": "User", "label": "Reviewer (Finance)"},
  {"fieldname": "detail_section", "fieldtype": "Section Break"},
  {"fieldname": "previous_line", "fieldtype": "Currency", "label": "Previous Line"},
  {"fieldname": "new_line", "fieldtype": "Currency", "label": "New Line"},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "decision", "fieldtype": "Select", "label": "Decision", "options": "Maintain\nIncrease\nDecrease\nZero (revoke)", "in_list_view": 1},
  {"fieldname": "md_approval", "fieldtype": "Link", "options": "Credit Exception Log", "label": "MD Approval"},
  {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "print": 1, "report": 1, "share": 1},
  {"role": "Finance Manager", "read": 1, "write": 1, "create": 1, "export": 1, "print": 1, "report": 1},
  {"role": "Managing Director", "read": 1, "write": 1, "print": 1, "report": 1}
 ],
 "sort_field": "review_date",
 "sort_order": "DESC"
}
