{
 "name": "Credit Assessment",
 "doctype": "DocType",
 "module": "Credit Management",
 "autoname": "format:CASS-{YYYY}-{#####}",
 "track_changes": 1,
 "description": "A completed file makes an account eligible for review — not eligible for credit. Only a Live assessment (Finance recommended + MD approved) grants a line.",
 "field_order": [
  "customer", "status", "column_break_top", "assessment_date",
  "file_section", "legal_buyer", "active_license_verified", "customer_group_exposure", "column_break_file", "payment_history", "expected_volume", "financial_capacity", "required_mitigants",
  "recommendation_section", "credit_score", "recommended_line", "recommended_term", "column_break_rec", "enhanced_assessment", "finance_recommended_by", "md_approval",
  "result_section", "applied_to_profile"
 ],
 "fields": [
  {"fieldname": "customer", "fieldtype": "Link", "options": "Customer", "label": "Customer", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nFinance Recommended\nMD Approved\nLive\nRejected", "default": "Draft", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "column_break_top", "fieldtype": "Column Break"},
  {"fieldname": "assessment_date", "fieldtype": "Date", "label": "Assessment Date", "default": "Today"},

  {"fieldname": "file_section", "fieldtype": "Section Break", "label": "Documented File (required before a line is recommended)"},
  {"fieldname": "legal_buyer", "fieldtype": "Data", "label": "Exact Legal Buyer", "reqd": 1},
  {"fieldname": "active_license_verified", "fieldtype": "Check", "label": "Active License Verified"},
  {"fieldname": "customer_group_exposure", "fieldtype": "Currency", "label": "Customer-Group Exposure (related entities combined)"},
  {"fieldname": "column_break_file", "fieldtype": "Column Break"},
  {"fieldname": "payment_history", "fieldtype": "Small Text", "label": "Payment History"},
  {"fieldname": "expected_volume", "fieldtype": "Small Text", "label": "Expected Volume"},
  {"fieldname": "financial_capacity", "fieldtype": "Small Text", "label": "Financial Capacity"},
  {"fieldname": "required_mitigants", "fieldtype": "Small Text", "label": "Required Mitigants"},

  {"fieldname": "recommendation_section", "fieldtype": "Section Break", "label": "Recommendation"},
  {"fieldname": "credit_score", "fieldtype": "Int", "label": "Credit Score (300-850)"},
  {"fieldname": "recommended_line", "fieldtype": "Currency", "label": "Recommended Line"},
  {"fieldname": "recommended_term", "fieldtype": "Select", "label": "Recommended Term", "options": "Net 15\nNet 30", "default": "Net 15"},
  {"fieldname": "column_break_rec", "fieldtype": "Column Break"},
  {"fieldname": "enhanced_assessment", "fieldtype": "Check", "label": "Enhanced Assessment (required for lines over $20,000)", "read_only": 1},
  {"fieldname": "finance_recommended_by", "fieldtype": "Link", "options": "User", "label": "Finance Recommended By"},
  {"fieldname": "md_approval", "fieldtype": "Link", "options": "Credit Exception Log", "label": "MD Approval (Credit Exception Log)"},

  {"fieldname": "result_section", "fieldtype": "Section Break", "label": "Result"},
  {"fieldname": "applied_to_profile", "fieldtype": "Check", "label": "Applied to Credit Profile", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "print": 1, "report": 1, "share": 1},
  {"role": "Finance Manager", "read": 1, "write": 1, "create": 1, "export": 1, "print": 1, "report": 1, "email": 1},
  {"role": "Managing Director", "read": 1, "write": 1, "print": 1, "report": 1},
  {"role": "Sales Manager", "read": 1, "report": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
