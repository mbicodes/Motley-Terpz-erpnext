{
 "name": "Credit Profile",
 "doctype": "DocType",
 "module": "Credit Management",
 "naming_rule": "By fieldname",
 "autoname": "field:customer",
 "title_field": "customer",
 "track_changes": 1,
 "description": "The single source of truth for a customer's credit standing. Default is COD until credit is formally approved.",
 "field_order": [
  "customer", "legal_buyer_name", "credit_group", "column_break_top", "status",
  "score_section", "credit_score", "credit_band",
  "line_section", "approved_line", "term", "column_break_line", "md_approval_reference",
  "compliance_section", "ap_contact_name", "ap_contact_phone", "ap_contact_email",
  "column_break_compliance", "reconciliation_clause_ack", "agreement_on_file",
  "hold_section", "hold_status", "hold_reason", "hold_since", "column_break_hold", "manual_hold", "manual_hold_reason",
  "exposure_section", "current_exposure", "past_due_amount", "column_break_exposure", "oldest_past_due_days", "last_computed_on"
 ],
 "fields": [
  {"fieldname": "customer", "fieldtype": "Link", "options": "Customer", "label": "Customer", "reqd": 1, "unique": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "legal_buyer_name", "fieldtype": "Data", "label": "Exact Legal Buyer"},
  {"fieldname": "credit_group", "fieldtype": "Link", "options": "Credit Group", "label": "Credit Group", "in_standard_filter": 1, "description": "Related entities share one combined line."},
  {"fieldname": "column_break_top", "fieldtype": "Column Break"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "COD\nCredit Approved\nPayment Plan\nWorkout\nFrozen", "default": "COD", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "description": "Default COD. Only a completed assessment + signed agreement + MD approval makes an account Credit Approved."},

  {"fieldname": "score_section", "fieldtype": "Section Break", "label": "Credit Score (300–850)"},
  {"fieldname": "credit_score", "fieldtype": "Int", "label": "Credit Score", "description": "300–850 (American standard)."},
  {"fieldname": "credit_band", "fieldtype": "Select", "label": "Band", "options": "\nPoor\nFair\nGood\nVery Good\nExceptional", "read_only": 1, "in_list_view": 1},

  {"fieldname": "line_section", "fieldtype": "Section Break", "label": "Line & Terms"},
  {"fieldname": "approved_line", "fieldtype": "Currency", "label": "Approved Line (max unsecured exposure)", "in_list_view": 1},
  {"fieldname": "term", "fieldtype": "Select", "label": "Term", "options": "COD\nNet 15\nNet 30", "default": "COD"},
  {"fieldname": "column_break_line", "fieldtype": "Column Break"},
  {"fieldname": "md_approval_reference", "fieldtype": "Data", "label": "MD Approval Reference", "description": "Written MD approval record (Credit Exception Log). Verbal approval does not count."},

  {"fieldname": "compliance_section", "fieldtype": "Section Break", "label": "Compliance & AP Contact"},
  {"fieldname": "ap_contact_name", "fieldtype": "Data", "label": "AP Contact Name"},
  {"fieldname": "ap_contact_phone", "fieldtype": "Data", "label": "AP Contact Direct Phone"},
  {"fieldname": "ap_contact_email", "fieldtype": "Data", "label": "AP Contact Email (not a general inbox)"},
  {"fieldname": "column_break_compliance", "fieldtype": "Column Break"},
  {"fieldname": "reconciliation_clause_ack", "fieldtype": "Check", "label": "Reconciliation Clause Acknowledged"},
  {"fieldname": "agreement_on_file", "fieldtype": "Check", "label": "Signed Credit Agreement on File"},

  {"fieldname": "hold_section", "fieldtype": "Section Break", "label": "Stop Work / Hold (engine-maintained)"},
  {"fieldname": "hold_status", "fieldtype": "Select", "label": "Hold Status", "options": "None\nWarning\nHard Hold\nImmediate Hold", "default": "None", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "hold_reason", "fieldtype": "Small Text", "label": "Hold Reason", "read_only": 1},
  {"fieldname": "hold_since", "fieldtype": "Datetime", "label": "Hold Since", "read_only": 1},
  {"fieldname": "column_break_hold", "fieldtype": "Column Break"},
  {"fieldname": "manual_hold", "fieldtype": "Check", "label": "Manual Immediate Hold (Finance)", "description": "Set by Finance for returned payment, broken promise, fraud, insolvency, etc. The engine will not clear this."},
  {"fieldname": "manual_hold_reason", "fieldtype": "Small Text", "label": "Manual Hold Reason", "depends_on": "manual_hold"},

  {"fieldname": "exposure_section", "fieldtype": "Section Break", "label": "Live Exposure (engine-maintained)"},
  {"fieldname": "current_exposure", "fieldtype": "Currency", "label": "Current Exposure (group)", "read_only": 1, "in_list_view": 1},
  {"fieldname": "past_due_amount", "fieldtype": "Currency", "label": "Past Due Amount", "read_only": 1},
  {"fieldname": "column_break_exposure", "fieldtype": "Column Break"},
  {"fieldname": "oldest_past_due_days", "fieldtype": "Int", "label": "Oldest Past Due (days)", "read_only": 1},
  {"fieldname": "last_computed_on", "fieldtype": "Datetime", "label": "Last Computed On", "read_only": 1}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "print": 1, "report": 1, "share": 1},
  {"role": "Finance Manager", "read": 1, "write": 1, "create": 1, "export": 1, "print": 1, "report": 1, "email": 1},
  {"role": "Managing Director", "read": 1, "print": 1, "report": 1, "email": 1},
  {"role": "Chief Executive Officer", "read": 1, "print": 1, "report": 1},
  {"role": "Sales Manager", "read": 1, "report": 1},
  {"role": "Sales User", "read": 1}
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
