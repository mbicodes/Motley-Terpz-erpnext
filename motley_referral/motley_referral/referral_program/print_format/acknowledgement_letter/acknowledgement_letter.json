{
 "doctype": "Print Format",
 "name": "Acknowledgement Letter",
 "doc_type": "Partner Referral",
 "module": "Referral Program",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "disabled": 0,
 "html": "\n<style>\n:root{--g:#1B7F4B;}\n.rp{font-family:Inter,Helvetica,Arial,sans-serif;font-size:10pt;color:#1f2328;line-height:1.4}\n.rp *{box-sizing:border-box}\n.rp .bar{background:#1B7F4B;color:#fff;padding:10px 14px;margin-bottom:14px}\n.rp .bar table{width:100%}\n.rp .bar, .rp .bar *{color:#fff!important}\n.rp .bar .t{font-size:16pt;font-weight:700;text-align:right}\n.rp .bar .n{font-size:10pt;text-align:right;opacity:.9}\n.rp .logo{max-height:38px}\n.rp .brand{font-size:14pt;font-weight:700;letter-spacing:.3px}\n.rp h3{font-size:10pt;text-transform:uppercase;letter-spacing:.6px;color:#1B7F4B;margin:16px 0 6px;border-bottom:1px solid #d0d7de;padding-bottom:3px}\n.rp table.t{width:100%;border-collapse:collapse;margin-bottom:8px}\n.rp table.t th{background:#1B7F4B!important;color:#fff!important;text-align:left;font-weight:600;padding:5px 7px;font-size:9pt}\n.rp table.t td{padding:5px 7px;border-bottom:1px solid #e5e8eb;vertical-align:top}\n.rp table.t tr{page-break-inside:avoid}\n.rp .r,.rp table.t th.r,.rp table.t td.r{text-align:right!important}\n.rp .tot td{background:#1B7F4B!important;color:#fff!important;font-weight:700;border:0}\n.rp .rev td{color:#c0392b}\n.rp .muted{color:#6a737d}\n.rp .meta{width:100%;margin-bottom:6px}.rp .meta td{vertical-align:top;padding:2px 0}\n.rp .meta .k{color:#6a737d;font-size:8.5pt;text-transform:uppercase;letter-spacing:.4px}\n.rp .badge{display:inline-block;padding:2px 10px;border-radius:10px;font-size:8.5pt;font-weight:700;color:#fff!important;background:#6a737d}\n.rp .badge.green{background:#1B7F4B}.rp .badge.blue{background:#2563eb}.rp .badge.red{background:#c0392b}\n.rp .badge.amber{background:#b7791f}.rp .badge.purple{background:#7c3aed}.rp .badge.dark{background:#374151}\n.rp .band{width:100%;border-collapse:separate;border-spacing:6px 0;margin:0 -6px 10px}\n.rp .band td{border:1px solid #d0d7de;border-top:3px solid #1B7F4B;padding:8px 10px;width:25%}\n.rp .band .l{font-size:8pt;text-transform:uppercase;color:#6a737d;letter-spacing:.4px}\n.rp .band .v{font-size:13pt;font-weight:700}\n.rp .box{border:1px solid #d0d7de;padding:8px 12px;margin-bottom:10px}\n.rp .box .bt{font-size:8.5pt;text-transform:uppercase;letter-spacing:.5px;color:#1B7F4B;font-weight:700;margin-bottom:4px}\n.rp .note{font-size:8.5pt;color:#6a737d;margin-top:14px;border-top:1px solid #d0d7de;padding-top:6px}\n.rp .wm{position:fixed;top:38%;left:8%;font-size:110pt;font-weight:700;color:rgba(0,0,0,.06);-webkit-transform:rotate(-30deg);z-index:0}\n.rp .strip{border-collapse:separate;border-spacing:2px;width:100%}\n.rp .strip td{text-align:center;font-size:8pt;padding:6px 0;color:#fff;border-radius:2px}\n.rp .strip td.y1{background:#8fcfae;color:#14532d}.rp .strip td.y2{background:#93b4f0;color:#1e3a8a}\n.rp .strip td.past.y1{background:#1B7F4B;color:#fff}.rp .strip td.past.y2{background:#2563eb;color:#fff}\n.rp .strip td.cur{background:#b7791f;color:#fff;font-weight:700}.rp .strip td.ended{background:#d1d5da;color:#6a737d}\n.rp .foot{margin-top:24px;font-size:8pt;color:#6a737d;text-align:center;border-top:1px solid #d0d7de;padding-top:4px;font-family:Helvetica,Arial,sans-serif}\n</style>\n<div class=\"rp\">\n<div class=\"bar\"><table><tr>\n<td>{% set logo = rp_company_logo(doc.get('company') or rp_default_company()) %}{% if logo and no_letterhead %}<img class=\"logo\" src=\"{{ logo }}\">{% elif not letter_head %}<span class=\"brand\">Motley</span>{% endif %}</td>\n<td><div class=\"t\">Acknowledgement</div><div class=\"n\">{{ doc.name }}</div></td>\n</tr></table></div>\n\n{% set partner = frappe.get_doc(\"Referral Partner\", doc.referral_partner) %}\n{% set sig = rp_signatory(doc.acknowledged_by) %}\n{% set ack = doc.acknowledged_on or frappe.utils.nowdate() %}\n<p style=\"margin-top:18px\">{{ frappe.utils.formatdate(ack, \"MMMM d, yyyy\") }}</p>\n<p><b>{{ partner.partner_name }}</b><br>{% if partner.address %}{{ partner.address | replace(\"\\n\", \"<br>\") }}<br>{% endif %}{{ partner.email }}</p>\n<p style=\"margin-top:18px\"><b>Subject: Acknowledgement of Referral &ndash; {{ doc.business_name }}</b></p>\n<p>Dear {{ partner.partner_name }},</p>\n<p>Thank you for introducing <b>{{ doc.business_name }}</b> to Motley. We are pleased to confirm that this referral has been reviewed and accepted under the Referral Partner Agreement.</p>\n<table class=\"t\" style=\"margin:14px 0\"><tbody>\n<tr><td style=\"width:35%\" class=\"muted\">Referral reference</td><td><b>{{ doc.name }}</b></td></tr>\n<tr><td class=\"muted\">Referred business</td><td><b>{{ doc.business_name }}</b></td></tr>\n<tr><td class=\"muted\">Acknowledgement date</td><td><b>{{ frappe.utils.formatdate(ack, \"MMMM d, yyyy\") }}</b></td></tr>\n</tbody></table>\n<p>Your commission window runs for <b>24 calendar months</b>, starting with the calendar month of the first qualifying payment received from this customer on or after the acknowledgement date:</p>\n<ul>\n<li><b>{{ \"%g\"|format(partner.year1_rate or 2) }}%</b> of payments received in Months 1&ndash;{{ partner.year1_months or 12 }};</li>\n<li><b>{{ \"%g\"|format(partner.year2_rate or 1) }}%</b> of payments received in Months {{ (partner.year1_months or 12) + 1 }}&ndash;{{ (partner.year1_months or 12) + (partner.year2_months or 12) }}.</li>\n</ul>\n<p>Payments received before the acknowledgement date do not earn commission. Commission is calculated on the amount actually received and is settled through your monthly commission statement.</p>\n<p>We appreciate your partnership and look forward to working with you.</p>\n<p style=\"margin-top:26px\">Sincerely,</p>\n<p style=\"margin-top:34px\"><b>{{ sig.name }}</b><br>{{ sig.title }}<br>Motley</p>\n</div>\n<div class=\"rp\"><div class=\"foot\">{{ rp_company_footer(rp_default_company()) }} &middot; Generated from Motley ERP on {{ frappe.utils.formatdate(frappe.utils.nowdate()) }}</div></div>\n",
 "margin_top": 15,
 "margin_bottom": 15,
 "margin_left": 15,
 "margin_right": 15,
