{
 "doctype": "Print Format",
 "name": "Referral Partner",
 "doc_type": "Referral Partner",
 "module": "Referral Program",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "disabled": 0,
 "html": "\n<style>\n:root{--g:#1B7F4B;}\n.rp{font-family:Inter,Helvetica,Arial,sans-serif;font-size:10pt;color:#1f2328;line-height:1.4}\n.rp *{box-sizing:border-box}\n.rp .bar{background:#1B7F4B;color:#fff;padding:10px 14px;margin-bottom:14px}\n.rp .bar table{width:100%}\n.rp .bar, .rp .bar *{color:#fff!important}\n.rp .bar .t{font-size:16pt;font-weight:700;text-align:right}\n.rp .bar .n{font-size:10pt;text-align:right;opacity:.9}\n.rp .logo{max-height:38px}\n.rp .brand{font-size:14pt;font-weight:700;letter-spacing:.3px}\n.rp h3{font-size:10pt;text-transform:uppercase;letter-spacing:.6px;color:#1B7F4B;margin:16px 0 6px;border-bottom:1px solid #d0d7de;padding-bottom:3px}\n.rp table.t{width:100%;border-collapse:collapse;margin-bottom:8px}\n.rp table.t th{background:#1B7F4B!important;color:#fff!important;text-align:left;font-weight:600;padding:5px 7px;font-size:9pt}\n.rp table.t td{padding:5px 7px;border-bottom:1px solid #e5e8eb;vertical-align:top}\n.rp table.t tr{page-break-inside:avoid}\n.rp .r,.rp table.t th.r,.rp table.t td.r{text-align:right!important}\n.rp .tot td{background:#1B7F4B!important;color:#fff!important;font-weight:700;border:0}\n.rp .rev td{color:#c0392b}\n.rp .muted{color:#6a737d}\n.rp .meta{width:100%;margin-bottom:6px}.rp .meta td{vertical-align:top;padding:2px 0}\n.rp .meta .k{color:#6a737d;font-size:8.5pt;text-transform:uppercase;letter-spacing:.4px}\n.rp .badge{display:inline-block;padding:2px 10px;border-radius:10px;font-size:8.5pt;font-weight:700;color:#fff!important;background:#6a737d}\n.rp .badge.green{background:#1B7F4B}.rp .badge.blue{background:#2563eb}.rp .badge.red{background:#c0392b}\n.rp .badge.amber{background:#b7791f}.rp .badge.purple{background:#7c3aed}.rp .badge.dark{background:#374151}\n.rp .band{width:100%;border-collapse:separate;border-spacing:6px 0;margin:0 -6px 10px}\n.rp .band td{border:1px solid #d0d7de;border-top:3px solid #1B7F4B;padding:8px 10px;width:25%}\n.rp .band .l{font-size:8pt;text-transform:uppercase;color:#6a737d;letter-spacing:.4px}\n.rp .band .v{font-size:13pt;font-weight:700}\n.rp .box{border:1px solid #d0d7de;padding:8px 12px;margin-bottom:10px}\n.rp .box .bt{font-size:8.5pt;text-transform:uppercase;letter-spacing:.5px;color:#1B7F4B;font-weight:700;margin-bottom:4px}\n.rp .note{font-size:8.5pt;color:#6a737d;margin-top:14px;border-top:1px solid #d0d7de;padding-top:6px}\n.rp .wm{position:fixed;top:38%;left:8%;font-size:110pt;font-weight:700;color:rgba(0,0,0,.06);-webkit-transform:rotate(-30deg);z-index:0}\n.rp .strip{border-collapse:separate;border-spacing:2px;width:100%}\n.rp .strip td{text-align:center;font-size:8pt;padding:6px 0;color:#fff;border-radius:2px}\n.rp .strip td.y1{background:#8fcfae;color:#14532d}.rp .strip td.y2{background:#93b4f0;color:#1e3a8a}\n.rp .strip td.past.y1{background:#1B7F4B;color:#fff}.rp .strip td.past.y2{background:#2563eb;color:#fff}\n.rp .strip td.cur{background:#b7791f;color:#fff;font-weight:700}.rp .strip td.ended{background:#d1d5da;color:#6a737d}\n.rp .foot{margin-top:24px;font-size:8pt;color:#6a737d;text-align:center;border-top:1px solid #d0d7de;padding-top:4px;font-family:Helvetica,Arial,sans-serif}\n</style>\n<div class=\"rp\">\n<div class=\"bar\"><table><tr>\n<td>{% set logo = rp_company_logo(doc.get('company') or rp_default_company()) %}{% if logo and no_letterhead %}<img class=\"logo\" src=\"{{ logo }}\">{% elif not letter_head %}<span class=\"brand\">Motley</span>{% endif %}</td>\n<td><div class=\"t\">Referral Partner</div><div class=\"n\">{{ doc.name }}</div></td>\n</tr></table></div>\n\n{% set refs = rp_partner_referrals(doc.name) %}\n{% set sts = rp_partner_statements(doc.name) %}\n<h3 style=\"margin-top:0\">Partner profile</h3>\n<table class=\"meta\"><tr>\n<td style=\"width:34%\"><div class=\"k\">Name</div><b>{{ doc.partner_name }}</b></td>\n<td style=\"width:33%\"><div class=\"k\">Type</div>{{ doc.partner_type }}</td>\n<td style=\"width:33%\"><div class=\"k\">Status</div><span class=\"badge {{ rp_badge(doc.status) }}\">{{ doc.status }}</span></td></tr>\n<tr><td><div class=\"k\">Email</div>{{ doc.email }}</td><td><div class=\"k\">Phone</div>{{ doc.phone or '-' }}</td><td><div class=\"k\">Address</div>{{ doc.address or '-' }}</td></tr>\n<tr><td><div class=\"k\">Agreement date</div>{{ frappe.utils.formatdate(doc.agreement_date) if doc.agreement_date else '-' }}</td>\n<td><div class=\"k\">Termination date</div>{{ frappe.utils.formatdate(doc.termination_date) if doc.termination_date else '-' }}</td>\n<td><div class=\"k\">Compliance confirmed</div>{{ 'Yes' if doc.compliance_confirmed else 'No' }}</td></tr>\n<tr><td><div class=\"k\">Year 1 rate / months</div>{{ \"%g\"|format(doc.year1_rate or 0) }}% / {{ doc.year1_months }}</td>\n<td><div class=\"k\">Year 2 rate / months</div>{{ \"%g\"|format(doc.year2_rate or 0) }}% / {{ doc.year2_months }}</td>\n<td><div class=\"k\">Payout</div>{{ doc.payout_method or '-' }} {{ rp_mask(doc.payout_details) }}</td></tr></table>\n\n<h3>Referrals</h3>\n<table class=\"t\"><thead><tr><th>Business</th><th>Status</th><th>Start date</th><th>Month</th><th class=\"r\">Commission to date</th></tr></thead><tbody>\n{% for r in refs %}<tr><td>{{ r.business_name }}<br><span class=\"muted\">{{ r.name }}</span></td><td><span class=\"badge {{ rp_badge(r.status) }}\">{{ r.status }}</span></td><td>{{ frappe.utils.formatdate(r.commission_start_date) if r.commission_start_date else '-' }}</td><td>{% if r.commission_start_date %}{{ r.current_month_no }} of 24{% else %}-{% endif %}</td><td class=\"r\">{{ rp_usd(r.total_commission) }}</td></tr>\n{% else %}<tr><td colspan=\"5\" class=\"muted\">No referrals yet.</td></tr>{% endfor %}\n<tr class=\"tot\"><td colspan=\"4\">Total</td><td class=\"r\">{{ rp_usd(refs|sum(attribute='total_commission')) }}</td></tr></tbody></table>\n\n<h3>Statements</h3>\n<table class=\"t\"><thead><tr><th>Period</th><th>Statement</th><th class=\"r\">Net payable</th><th>Status</th></tr></thead><tbody>\n{% for s in sts %}<tr><td>{{ rp_month_label(s.period) }}</td><td>{{ s.name }}</td><td class=\"r\">{{ rp_usd(s.net_payable) }}</td><td><span class=\"badge {{ rp_badge(s.status) }}\">{{ s.status }}</span></td></tr>\n{% else %}<tr><td colspan=\"4\" class=\"muted\">No statements yet.</td></tr>{% endfor %}</tbody></table>\n</div>\n<div class=\"rp\"><div class=\"foot\">{{ rp_company_footer(rp_default_company()) }} &middot; Generated from Motley ERP on {{ frappe.utils.formatdate(frappe.utils.nowdate()) }}</div></div>\n",
 "margin_top": 15,
 "margin_bottom": 15,
 "margin_left": 15,
 "margin_right": 15,
 "font_size": 10,
